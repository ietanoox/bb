---
import { href, asset } from '../lib/urls';
interface Props { current?: string; }
const { current = '' } = Astro.props;
---
<header class="site-header container">
  <a class="brand" href={href()} aria-label="Broad Branding home">
    <img src={asset('broadbranding-logo.png')} width="651" height="226" alt="Broad Branding" fetchpriority="high" />
  </a>
  <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="primary-navigation"><span></span><span></span><span></span></button>
  <nav id="primary-navigation" aria-label="Main navigation">
    <a href={href('about-us/')} aria-current={current === 'about' ? 'page' : undefined}>About Us</a>
    <a href={href('#projects')}>Portfolio</a>
    <a href={href('contact-us/')} aria-current={current === 'contact' ? 'page' : undefined}>Contact Us</a>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-navigation');
  function closeMenu() { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Open menu'); nav?.classList.remove('is-open'); }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
  });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeMenu(); toggle?.focus(); } });
  document.addEventListener('click', event => { if (event.target instanceof Node && !document.querySelector('.site-header')?.contains(event.target)) closeMenu(); });
</script>
<style>
  .site-header { display: flex; align-items: center; gap: 20px; margin-top: 9px; }
  .brand { flex: 0 1 651px; }
  .brand img { width: 208.32px; }
  nav { display: flex; flex: 1; gap: 16px; }
  nav a { display: block; padding: 8px; font-size: 16px; line-height: 24px; font-weight: 400; color: #333; }
  .menu-toggle { display: none; width: 40px; height: 40px; border: 0; background: transparent; padding: 10px; color: var(--color-heading); }
  .menu-toggle span { display: block; height: 2px; background: currentColor; margin: 4px 0; }
  @media (max-width: 1024px) {
    .site-header { flex-wrap: wrap; }
    .brand { flex: 1; }
    .menu-toggle { display: block; margin-left: auto; }
    nav { display: none; flex: 0 0 100%; text-align: center; }
    nav.is-open { display: block; }
    nav a { padding: 13px 16px; }
  }
  @media (max-width: 767px) {
    .site-header { flex-wrap: wrap; justify-content: center; gap: 0; padding-top: 28px; padding-bottom: 9px; }
    .brand { flex: 0 0 100%; }
    .brand img { width: 45%; max-width: 240px; margin-inline: auto; }
    .menu-toggle { display: block; margin: 12px auto 0; }
    nav { display: none; flex: 0 0 100%; width: 100%; margin: 0; text-align: center; }
    nav.is-open { display: block; }
    nav a { padding: 13px 16px; }
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  @media (scripting: none) { .menu-toggle { display: none; } nav { display: flex; justify-content: center; flex-wrap: wrap; } }
</style>
