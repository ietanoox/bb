---
import { asset } from '../lib/urls';
const projects = [
  ['work-1-768x819.webp', 'Plan B&B hospitality project'],
  ['work-2-768x819.webp', 'Broad Branding project photography'],
  ['work-3-768x819.webp', 'Hospitality branding project'],
  ['work-5-768x819.webp', 'Broad Branding creative project'],
];
---
<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="container"><h2 id="projects-title" class="section-title">Our Projects</h2></div>
  <div class="carousel container" role="region" aria-roledescription="carousel" aria-label="Our projects">
    <div class="project-track" tabindex="0" aria-label="Project images; use arrow keys to browse">
      {projects.map(([filename, alt], index) => <figure role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${projects.length}`}><img src={asset(filename)} width="768" height="819" alt={alt} loading="lazy" /></figure>)}
    </div>
    <button class="previous" aria-label="Previous slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 4-8 8 8 8" /></svg></button>
    <button class="next" aria-label="Next slide"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg></button>
    <span class="carousel-status" aria-live="polite"></span>
  </div>
</section>
<script>
  const carousel = document.querySelector<HTMLElement>('.carousel');
  const track = carousel?.querySelector<HTMLElement>('.project-track');
  const status = carousel?.querySelector<HTMLElement>('.carousel-status');
  if (carousel && track) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    const advance = (direction: number, announce = true) => {
      const first = track.querySelector('figure');
      if (!first) return;
      const step = first.getBoundingClientRect().width + 20;
      const max = track.scrollWidth - track.clientWidth;
      const target = direction > 0 && track.scrollLeft >= max - 2 ? 0 : direction < 0 && track.scrollLeft <= 2 ? max : track.scrollLeft + step * direction;
      track.scrollTo({ left: target, behavior: reduceMotion.matches ? 'instant' : 'smooth' });
      if (announce && status) status.textContent = `Showing project ${Math.min(4, Math.max(1, Math.round(target / step) + 1))} of 4`;
    };
    const stop = () => { if (timer) clearInterval(timer); };
    const start = () => { stop(); if (!paused && !reduceMotion.matches && !document.hidden) timer = setInterval(() => advance(1, false), 5000); };
    const manual = (direction: number) => { paused = true; stop(); advance(direction); };
    carousel.querySelector('.previous')?.addEventListener('click', () => manual(-1));
    carousel.querySelector('.next')?.addEventListener('click', () => manual(1));
    track.addEventListener('keydown', event => { if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); manual(event.key === 'ArrowRight' ? 1 : -1); } });
    track.addEventListener('pointerdown', () => { paused = true; stop(); });
    carousel.addEventListener('pointerenter', stop);
    carousel.addEventListener('pointerleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', start);
    reduceMotion.addEventListener('change', start);
    start();
  }
</script>
<style>
  .projects { margin-top: 0; }
  .carousel { position: relative; margin-top: 60px; margin-bottom: 60px; padding-inline: 40px; }
  .project-track { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 6px; }
  .project-track::-webkit-scrollbar { display: none; }
  figure { flex: 0 0 calc((100% - 40px) / 3); margin: 0; scroll-snap-align: start; }
  figure img { width: 100%; }
  button { position: absolute; top: 50%; transform: translateY(-50%); width: 28px; height: 42px; border: 0; background: white; padding: 3px; color: var(--color-heading); }
  button svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 3; }
  .previous { left: 10px; } .next { right: 10px; }
  .carousel-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  @media (max-width: 767px) { figure { flex-basis: 100%; } .carousel { margin-top: 45px; } }
</style>
