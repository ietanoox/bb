---
import SiteLayout from '../layouts/SiteLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Partners from '../components/Partners.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import { asset } from '../lib/urls';
---
<SiteLayout title="Broad Branding | Project Management, Marketing & Strategy Experts" description="Broad Branding helps businesses grow through expert project management, marketing, sustainability, strategy, and other services." current="home">
  <main id="content">
    <section class="home-hero container">
      <h1>Everything you need to be better than you were.</h1>
    </section>
    <section class="home-intro container" aria-label="About Broad Branding">
      <div class="intro-copy">
        <p>Broad Branding focuses on one thing: helping businesses and organizations become better.</p>
        <p>A wide range of consulting services in project management, marketing, sustainability, business strategy, technology innovation and cloud services will help any business to become successful.</p>
      </div>
      <img src={asset('wall-logo-768x995.webp')} srcset={`${asset('wall-logo-768x995.webp')} 768w, ${asset('wall-logo.webp')} 1112w`} sizes="(max-width: 767px) 100vw, 30vw" width="768" height="995" alt="Broad Branding wall logo" loading="lazy" />
    </section>
    <section class="home-services" aria-labelledby="services-title">
      <div class="service-heading container"><h2 id="services-title">We worry about the details so you don't have to.</h2></div>
      <ServiceGrid />
    </section>
    <Partners />
    <ProjectCarousel />
  </main>
</SiteLayout>
<style>
  .home-hero { min-height: 850px; display: flex; flex-direction: column; justify-content: center; text-align: center; }
  h1 { font-size: 120px; }
  .home-intro { display: grid; grid-template-columns: 20% 30% 30% 20%; align-items: center; }
  .intro-copy { grid-column: 2; padding: 10px; font-size: 22px; font-weight: 500; line-height: 1.3; }
  .intro-copy p + p { margin-top: 34px; }
  .home-intro > img { width: 100%; padding: 10px; }
  .home-services { margin-top: 90px; }
  .service-heading { text-align: center; margin-bottom: 18px; }
  .service-heading h2 { font-size: 30px; }
  @media (max-width: 1024px) { h1 { font-size: 100px; } .intro-copy { font-size: 18px; } }
  @media (max-width: 767px) {
    .home-hero { min-height: 300px; }
    h1 { font-size: 48px; }
    .home-intro { display: flex; flex-direction: column-reverse; }
    .home-intro > img { width: 100%; }
    .intro-copy { font-size: 16px; }
    .home-services { margin-top: 30px; }
    .service-heading { margin-bottom: 0; padding: 20px; }
    .service-heading h2 { font-size: 26px; }
  }
</style>
