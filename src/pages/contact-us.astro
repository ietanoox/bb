---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Contact Broad Branding | Let's Build Your Next Project"
  description="Get in touch with Broad Branding in St. Julians, Malta. Call or email us to discuss your next business project."
  current="contact"
>
  <main id="content">
    <section class="contact-title" aria-labelledby="contact-title">
      <h1 id="contact-title">Contacts</h1>
    </section>

    <section class="contact-details" aria-label="Contact details">
      <div class="contact-details__inner">
        <div class="contact-detail">
          <h2>Address</h2>
          <address>77, Spinola Road, St Julians<br />STJ 3017, Malta</address>
        </div>
        <div class="contact-detail">
          <h2>Phone</h2>
          <a href="tel:+35627780309">+356 2778 0309</a>
        </div>
        <div class="contact-detail">
          <h2>E-mail</h2>
          <a href="mailto:info@broadbranding.com">info@broadbranding.com</a>
        </div>
      </div>
    </section>

    <section class="contact-map" aria-label="Our location">
      <div class="contact-map__inner">
        <iframe
          loading="lazy"
          src="https://maps.google.com/maps?q=77%2C%20Spinola%20Road%2C%20St%20Julians%20STJ%203017%2C%20Malta&t=m&z=15&output=embed&iwloc=near"
          title="77, Spinola Road, St Julians STJ 3017, Malta"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .contact-title { padding: 60px; text-align: center; }
  .contact-title h1 { margin: 0; font-size: 120px; line-height: 1.1; font-weight: 700; }
  .contact-details { padding: 60px; }
  .contact-details__inner {
    max-width: 1140px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
  }
  .contact-detail { display: flex; flex-direction: column; gap: 20px; padding: 10px; text-align: center; }
  .contact-detail h2 { margin: 0; font-size: 32px; line-height: 1; font-weight: 700; }
  .contact-detail address { font-style: normal; }
  .contact-detail a { overflow-wrap: anywhere; text-decoration: none; }
  .contact-detail a:hover { text-decoration: underline; }
  .contact-map { padding: 60px; }
  .contact-map__inner { max-width: 1140px; margin-inline: auto; border-radius: 6px; overflow: hidden; }
  .contact-map iframe { display: block; width: 100%; height: 489px; border: 0; }
  @media (max-width: 767px) {
    .contact-title, .contact-details, .contact-map { padding: 20px; }
    .contact-title h1 { font-size: 50px; }
    .contact-details__inner { grid-template-columns: 1fr; }
    .contact-detail { padding: 20px; }
  }
</style>
