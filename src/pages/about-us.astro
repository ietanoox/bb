---
import SiteLayout from '../layouts/SiteLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Partners from '../components/Partners.astro';
import { asset } from '../lib/urls';
---

<SiteLayout
  title="About Broad Branding | Creative Business Growth Experts"
  description="Learn about Broad Branding, a Malta-based agency helping businesses grow through design, marketing, strategy, and innovation."
  current="about"
>
  <main id="content">
    <section class="about-intro" aria-labelledby="about-title">
      <div class="about-intro__inner">
        <div class="about-image">
          <img
            src={asset('wall-logo-791x1024.webp')}
            srcset={`${asset('wall-logo-768x995.webp')} 768w, ${asset('wall-logo-791x1024.webp')} 791w, ${asset('wall-logo.webp')} 1112w`}
            sizes="(max-width: 767px) calc(100vw - 60px), (max-width: 1259px) calc((100vw - 196px) / 2), 532px"
            width="791"
            height="1024"
            alt="Broad Branding wall logo"
            fetchpriority="high"
          />
        </div>
        <div class="about-copy">
          <h1 id="about-title">About Us</h1>
          <div>
            <p>Broad Branding is a company that provides you with everything you need to be better than you were.</p>
            <p>We focus on one thing: helping businesses and organizations become better. Whether that’s through our web design services, our graphic design services, or any of the other things we do to make your business succeed.</p>
            <p>If you have an idea, we’ll help you make it happen.</p>
          </div>
        </div>
      </div>
    </section>

    <Partners variant="about" />

    <section class="team" aria-labelledby="team-title">
      <div class="team__inner">
        <h2 id="team-title">The Team</h2>
        <div class="team-members">
          <article class="team-member">
            <img
              class="team-member__portrait team-member__portrait--founder"
              src={asset('gio.jpeg')}
              width="800"
              height="800"
              loading="lazy"
              decoding="async"
              alt="Giovanni Paticchio"
            />
            <h3>Giovanni Paticchio</h3>
            <p>CEO &amp; Founder</p>
          </article>
          <article class="team-member">
            <img
              class="team-member__portrait team-member__portrait--director"
              src={asset('director.webp')}
              width="1024"
              height="1024"
              loading="lazy"
              decoding="async"
              alt="Charlene Fenech"
            />
            <h3>Charlene Fenech</h3>
            <p>Director</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-services" aria-labelledby="services-title">
      <div class="container about-services__heading">
        <h2 id="services-title">We worry about the details so you don't have to.</h2>
      </div>
      <ServiceGrid compact />
    </section>
  </main>
</SiteLayout>

<style>
  .about-intro { padding: 60px; }
  .about-intro__inner {
    max-width: 1140px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 36px;
  }
  .about-image, .about-copy { padding: 10px; }
  .about-image img { display: block; width: 100%; height: auto; }
  .about-copy { display: flex; flex-direction: column; gap: 20px; }
  .about-copy h1 { margin: 0; font-size: 52px; font-weight: 700; line-height: 1.1; }
  .about-copy p { margin: 0 0 .9rem; font-size: 22px; line-height: 1.3; font-weight: 500; }
  .team { padding: 80px; }
  .team__inner { max-width: 1140px; margin-inline: auto; }
  .team h2 { margin: 0 0 100px; text-align: center; font-size: 87px; line-height: 1.1; font-weight: 700; }
  .team-members { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; padding: 10px; }
  .team-member { text-align: center; }
  .team-member__portrait { display: block; height: auto; aspect-ratio: 1; object-fit: cover; margin: 0 auto 15px; }
  .team-member__portrait--founder { width: 38%; }
  .team-member__portrait--director { width: 30%; }
  .team-member h3 { margin: .5rem 0 1rem; font-size: 18px; line-height: 1.1; font-weight: 700; }
  .team-member p { margin: 0; }
  .about-services { margin-bottom: 60px; }
  .about-services__heading { padding-block: 10px 56px; }
  .about-services h2 { margin: 0; font-size: 40px; font-weight: 700; line-height: 1.2; text-align: center; }
  @media (max-width: 1024px) {
    .about-copy h1 { font-size: 40px; }
    .about-copy p { font-size: 18px; }
    .team h2 { font-size: 70px; }
    .about-services h2 { line-height: 1.3; }
  }
  @media (max-width: 767px) {
    .about-intro { padding: 20px; }
    .about-intro__inner { grid-template-columns: 1fr; gap: 20px; }
    .about-copy h1 { text-align: center; }
    .about-copy p { font-size: 16px; }
    .team { padding: 40px 20px; }
    .team h2 { margin-bottom: 50px; font-size: 48px; }
    .team-members { gap: 24px; }
    .team-member__portrait--founder { width: 80%; }
    .team-member__portrait--director { width: 65%; }
    .team-member h3 { font-size: 18px; }
    .team-member p { font-size: 16px; }
    .about-services h2 { font-size: 24px; }
    .about-services__heading { padding-inline: 20px; padding-bottom: 36px; }
  }
  @media (max-width: 380px) {
    .team-members { grid-template-columns: 1fr; gap: 40px; }
    .team-member__portrait--founder { width: 50%; }
    .team-member__portrait--director { width: 40%; }
  }
</style>
